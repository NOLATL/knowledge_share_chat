# Playbook — environment variables.
# Copy to `.env` and fill in real values. Never commit `.env`.
# Each variable is declared in the task that introduces it (see BUILD_PLAN.md).

# --- Task 0.1 ---
# OpenAI API key (used by api + worker for chat/extraction/embeddings).
OPENAI_API_KEY=
# Postgres connection string (pgvector-enabled). Railway injects this in prod.
# Local example: postgresql://postgres:postgres@localhost:5432/playbook
DATABASE_URL=

# --- Task 0.3 ---
# Mount path of the Railway Volume for uploaded files (api). Container FS is
# ephemeral, so uploads MUST live here. Local example: ./data/uploads
UPLOAD_VOLUME_PATH=

# --- Task 1.2 ---
# Streamed conversational model (two-call pattern, call A). Pin a dated snapshot
# (e.g. gpt-5.4-mini-2026-03-05) for reproducibility if desired.
OPENAI_CHAT_MODEL=gpt-5.4-mini
# Optional OpenAI-compatible base URL override (leave blank for OpenAI).
OPENAI_BASE_URL=

# --- Task 1.3 ---
# Structured-extraction / reports model (two-call pattern, call B). Strict
# Structured Outputs. Pin a dated snapshot (e.g. gpt-5.4-2026-03-05) if desired.
OPENAI_EXTRACTION_MODEL=gpt-5.4
# Non-streamed report generation model (Epic 4). Keep cheap by default; swap env
# only if generated report quality needs a stronger model.
OPENAI_REPORT_MODEL=gpt-5.4-mini

# --- Epic 2 ---
# Low-cost model for synthetic respondent answer generation and cluster labels.
OPENAI_SYNTHETIC_MODEL=gpt-4o-mini
OPENAI_SYNTHETIC_FALLBACK_MODEL=gpt-4.1-mini
# --- Task 8.4 ---
# Low-cost model for LLM cluster persona labeling (one call per cluster per
# recompute; heuristic fallback on failure).
OPENAI_LABELING_MODEL=gpt-4o-mini
# Embedding model; schema is vector(1536), matching text-embedding-3-small.
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# Manual analytics recompute endpoint bearer token.
ADMIN_RECOMPUTE_TOKEN=
# Synthetic generation controls.
SYNTHETIC_TARGET_COUNT=150
SYNTHETIC_SEED=20260628

# --- Task 1.4 (web) ---
# Server-side base URL the Next.js BFF uses to reach the FastAPI service.
# Local: http://localhost:8000 ; Railway: ${{api.RAILWAY_PRIVATE_DOMAIN}} based URL.
API_BASE_URL=http://localhost:8000

# --- Epic 3 ---
# Synchronous demo upload limit for parsed/RAG-ready documents.
DOCUMENT_MAX_UPLOAD_MB=10

# --- Epic 5 ---
# Public base URL used in colleague relay links.
PUBLIC_WEB_BASE_URL=http://localhost:3000
# Optional override if relay links should use a different external origin.
RELAY_BASE_URL=
# Single-use relay expiration window.
RELAY_EXPIRES_HOURS=168
# Optional Resend delivery. If unset, relay creation logs and returns the link.
RESEND_API_KEY=
EMAIL_FROM=Playbook <onboarding@resend.dev>

# --- Demo vendor ---
# Fictional vendor the internal (presales) reports are written for; its product
# is described in knowledge/vendor_capabilities.md. Used by api + web.
VENDOR_NAME=Corbel Analytics
